# Flask配置
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 设备配置
DEVICE_ID=dev-001
MERCHANT_ID=merchant-001
DEVICE_ALIAS=咖啡机-大厅
DEVICE_MODEL=CM-2000
FIRMWARE_VERSION=1.0.0

# 支付配置
PAYMENT_TIMEOUT=300
ENABLE_WECHAT_PAY=True
ENABLE_ALIPAY=True
WECHAT_APP_ID=
WECHAT_MCH_ID=
ALIPAY_APP_ID=

# UI配置
SCREENSAVER_TIMEOUT=30
DONE_PAGE_DURATION=10
ENABLE_QUEUE=False
DEFAULT_LANGUAGE=zh-CN
DEFAULT_PIN=0000

# 物料配置
LOW_MATERIAL_THRESHOLD=20
AUTO_REPORT_MATERIALS=True

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=device.log
